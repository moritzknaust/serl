"""serl upgrade config.

Generated by go/python-puppy."""

# To upgrade to the latest version of serl, run go/copybara:
#     copybara third_party/py/serl/copy.bara.sky
# To explicitly upgrade to a specific version, run:
#     copybara third_party/py/serl/copy.bara.sky default <branch_name>|<git_tag>|<git_hash>
load("//devtools/python/janitor/puppy/puppy", "git_to_third_party_py")

git_origin_url = "https://github.com/rail-berkeley/serl/tree/main/serl_launcher"

python_package_name = "serl_launcher"

version_selector = None

git_exclude = [
    # exclude all dotfiles
    ".*",
    "**/.*",
    ".*/**",

    # exclude python packaging and non-google3 build system files
    "MANIFEST*",
    "appveyor.yml",
    "circle.yml",
    "codecov*.yml",
    "setup.cfg",
    "setup.py",
    "Makefile*",
    "**/Makefile*",
    "**/CMakeLists.txt",
    "GNUmakefile",
    "meson.build",
    "**/meson.build",
    "appveyor/**",
    "debian*/**",
    "tox.ini",
    "pytest.ini",
    "mypy.ini",
    "poetry.lock",
    "*requirements*.txt",
    "azure-pipelines.yml",
    "environment.yml",
    "WORKSPACE",
    "BUILD.bazel",
    "**/BUILD.bazel",
    "BUILD",
    "**/BUILD",
    "Dockerfile",
    "*.spec",  # Fedora RPM spec files
    "Pipfile",
    "**/__pycache__/**",
    "**/*.pyc",
    "ci/**",

    # exclude package documentation
    "doc/**",
    "docs/**",
    "README*",
    "AUTHOR*",
    "RELEAS*",
    "CONTRIB*",
    "CODE_OF_CONDUCT*",
    "code-of-conduct*",
    "TODO",
    "example*/**",
    "readthedocs.yml",
    "*_TEMPLATE.md",
]

google3_exclude = [
    "BUILD",
    "**/BUILD",
    "METADATA",
    "OWNERS",
    "OWNERS_METADATA",
    "patches/**",
    "copy.bara.sky",
    "g3doc/**",
    "README.md",
    "**.blueprint",
    "bluze.textproto",
    "puppy_auto.patch",
    ".pc/**",
]

transformations = [
]

git_to_third_party_py(
    git_origin_url = git_origin_url,
    python_package_name = python_package_name,
    git_files = glob(
        include = ["**"],
        exclude = git_exclude,
    ),
    google3_exclude = google3_exclude,
    transformations = transformations,
    merge_import = True,
    version_selector = version_selector,
    git_ref = "main",
)
